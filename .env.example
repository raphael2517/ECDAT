# ECDAT - Environment Configuration
# Copy to .env and adjust. All paths are relative to the project root.

# Host UID/GID so bind-mounted ./output files are owned by you, not root
UID=1000
GID=1000

# Where generated CBOMs and reports are written
OUTPUT_DIR=./output

# Directory of Semgrep rule YAML files
SCANNER_RULES_PATH=./scanner/rules

# Baked-in liboqs install prefix inside the container.
# The liboqs-python wheel is pure Python; it ctypes-loads liboqs.so from here.
OQS_INSTALL_PATH=/opt/oqs

# Mosca collapse-time (Z) estimate, in years. Drives Risk = (X + Y) > Z.
# Re-rankable at runtime via POST /api/risk/recalculate/{id}?z=<value>
Z_ESTIMATE=15

# Default scan target used by `make scan` when TARGET is not given
SCAN_TARGET=.
