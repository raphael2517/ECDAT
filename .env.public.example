# ECDAT - exposure policy for a publicly reachable deployment.
#
# Copy to .env (or set these in your tunnel host's environment) before running
# ECDAT anywhere other than localhost:
#
#     set -a && . ./.env.public && set +a && make up
#
# Every variable here REDUCES what an unauthenticated caller can do. With none
# of them set, the service behaves exactly as it does on a laptop: any readable
# path can be scanned, any hostname can be cloned, and there is no key.

# --- required for any public exposure ---------------------------------------
# Long random string. Generate with:  openssl rand -base64 32
# Sent by the UI in the X-ECDAT-Key header, and as ?key= on the WebSocket
# (browsers cannot set headers on a WS handshake).
# Without this, /api is open to anyone who can reach the port.
ECDAT_API_KEY=

# --- strongly recommended ----------------------------------------------------
# Only targets under this directory may be scanned by local-path or zip
# target. Unset means ANY readable path on the host can be scanned and its
# contents returned in the CBOM - including the container's own source.
# Put demo material here and keep it small.
ECDAT_SCAN_ROOT=./demo-targets

# At most this many scans run at once. Each is a Semgrep run plus optional
# crypto benchmarks; without a ceiling one caller can pin every core.
ECDAT_MAX_CONCURRENT_SCANS=2

# --- leave unset unless you mean it ------------------------------------------
# Permit cloning from private/loopback/link-local hosts. Only needed if the
# repository you want to scan lives on your own network. Turning this on
# re-opens SSRF against everything reachable from this machine, including the
# cloud metadata endpoint at 169.254.169.254.
# ECDAT_ALLOW_PRIVATE_NETWORK=1

# --- Cloudflare --------------------------------------------------------------
# Used by the quick tunnel below. Not needed for a named tunnel, which reads
# its credentials from ~/.cloudflared/<tunnel>.json.
# CLOUDFLARE_TUNNEL_TOKEN=
